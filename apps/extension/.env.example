# Build-time config for sync and the ladder query (S11). Copy to `.env` (gitignored).
# WXT exposes WXT_* variables as import.meta.env.WXT_*.
#
# The API origin. Defaults to staging when unset; set to the production Worker for a release.
WXT_API_BASE_URL=https://pennypincher-api-staging.jamesjlee04.workers.dev
# The pilot bearer (S08, a `wrangler secret`). Never commit a real value. Empty = sync off.
WXT_PILOT_TOKEN=
